<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <LangVersion>14</LangVersion>
        <RootNamespace>LabProject</RootNamespace>
        <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="CommunityToolkit.Diagnostics" Version="8.4.2" />
      <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
      <PackageReference Include="System.Buffers" Version="4.6.1" />
      <PackageReference Include="System.Memory" Version="4.6.3" />
      <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="LabProject.Shared.csproj.user" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="Assembly-CSharp">
            <HintPath>$(AssembliesPath)Assembly-CSharp-Publicized.dll</HintPath>
        </Reference>
        <Reference Include="Assembly-CSharp-firstpass">
            <HintPath>$(AssembliesPath)Assembly-CSharp-firstpass.dll</HintPath>
        </Reference>
        <Reference Include="CommandSystem.Core">
            <HintPath>$(AssembliesPath)CommandSystem.Core.dll</HintPath>
        </Reference>
        <Reference Include="Mirror">
            <HintPath>$(AssembliesPath)Mirror.dll</HintPath>
        </Reference>
        <Reference Include="Mirror.Components">
            <HintPath>$(AssembliesPath)Mirror.Components.dll</HintPath>
        </Reference>
        <Reference Include="mscorlib">
            <HintPath>$(AssembliesPath)mscorlib.dll</HintPath>
        </Reference>
        <Reference Include="netstandard">
            <HintPath>$(AssembliesPath)netstandard.dll</HintPath>
        </Reference>
        <Reference Include="NorthwoodLib">
            <HintPath>$(AssembliesPath)NorthwoodLib.dll</HintPath>
        </Reference>
        <Reference Include="System">
            <HintPath>$(AssembliesPath)System.dll</HintPath>
        </Reference>
        <Reference Include="System.Core">
            <HintPath>$(AssembliesPath)System.Core.dll</HintPath>
        </Reference>
        <Reference Include="System.Memory">
            <HintPath>$(AssembliesPath)System.Memory.dll</HintPath>
        </Reference>
        <Reference Include="System.Runtime">
            <HintPath>$(AssembliesPath)System.Runtime.dll</HintPath>
        </Reference>
        <Reference Include="UniTask">
            <HintPath>..\_References\UniTask.dll</HintPath>
        </Reference>
        <Reference Include="UniTask.DOTween">
            <HintPath>..\_References\UniTask.DOTween.dll</HintPath>
        </Reference>
        <Reference Include="UniTask.Linq">
            <HintPath>..\_References\UniTask.Linq.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <HintPath>$(AssembliesPath)UnityEngine.CoreModule.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.Physics2DModule">
            <HintPath>$(AssembliesPath)UnityEngine.Physics2DModule.dll</HintPath>
        </Reference>
    </ItemGroup>

    <Target Name="CopyFileAfterBuild" AfterTargets="AfterBuild">
        <Copy
                SourceFiles="$(TargetDir)LabProject.Shared.dll"
                DestinationFolder="$(CopyPath)"
                SkipUnchangedFiles="false" />
    </Target>
</Project>
